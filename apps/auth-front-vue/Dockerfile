FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

ARG VITE_AUTH_BASE_URL
ARG VITE_USERS_BASE
ARG VITE_APPOINTMENTS_BASE_URL
ARG VITE_CASES_BASE_URL
ARG VITE_AUDIT_BASE_URL
ARG VITE_REPORTS_BASE_URL
ARG VITE_ADMIN_BASE_URL
ARG VITE_CLAIMS_BASE_URL
ARG VITE_COVERAGE_URL
ARG VITE_NOTIFICATIONS_BASE_URL

ENV VITE_AUTH_BASE_URL=$VITE_AUTH_BASE_URL \
    VITE_USERS_BASE=$VITE_USERS_BASE \
    VITE_APPOINTMENTS_BASE_URL=$VITE_APPOINTMENTS_BASE_URL \
    VITE_CASES_BASE_URL=$VITE_CASES_BASE_URL \
    VITE_AUDIT_BASE_URL=$VITE_AUDIT_BASE_URL \
    VITE_REPORTS_BASE_URL=$VITE_REPORTS_BASE_URL \
    VITE_ADMIN_BASE_URL=$VITE_ADMIN_BASE_URL \
    VITE_CLAIMS_BASE_URL=$VITE_CLAIMS_BASE_URL \
    VITE_COVERAGE_URL=$VITE_COVERAGE_URL \
    VITE_NOTIFICATIONS_BASE_URL=$VITE_NOTIFICATIONS_BASE_URL

RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
