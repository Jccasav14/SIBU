{
  "name": "claims",
  "projectType": "application",
  "sourceRoot": "apps/claims/app",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": ".\\.venv\\Scripts\\python.exe -m uvicorn apps.claims.app.main:app --host 0.0.0.0 --port 8009 --reload"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/claims",
        "command": "pytest -q"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/claims",
        "command": "python -m compileall app"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "docker build -f apps/claims/Dockerfile -t sibu-claims:local ."
      }
    }
  }
}
