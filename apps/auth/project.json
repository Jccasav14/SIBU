{
  "name": "auth",
  "projectType": "application",
  "sourceRoot": "apps/auth/app",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "python -m uvicorn apps.auth.app.main:app --host 0.0.0.0 --port 8001 --reload"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "npx cross-env PYTHONPATH=. python -m pytest -q --import-mode=importlib apps/auth/tests"
      }
    }

    ,
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/auth",
        "command": "python -m compileall app"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "docker build -f apps/auth/Dockerfile -t jccasav/sibu-auth:local ."
      }
    },
    "docker-push": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "bash tools/docker/push.sh auth"
      }
    }
  }
}
