{
  "name": "audit-log",
  "projectType": "application",
  "sourceRoot": "apps/audit_log/app",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": ".\\.venv\\Scripts\\python.exe -m uvicorn apps.audit_log.app.main:app --host 0.0.0.0 --port 8006 --reload"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/audit_log",
        "command": "pytest -q"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/audit_log",
        "command": "python -m compileall app"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "docker build -f apps/audit_log/Dockerfile -t sibu-audit-log:local ."
      }
    }
  }
}
