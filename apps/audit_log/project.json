{
  "name": "audit-log",
  "projectType": "application",
  "sourceRoot": "apps/audit_log/app",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "python -m uvicorn apps.audit_log.app.main:app --host 0.0.0.0 --port 8006 --reload"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "npx cross-env PYTHONPATH=. .\\.venv\\Scripts\\python.exe -m pytest -q --import-mode=importlib apps/audit_log/tests"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/audit_log",
        "command": "python -m compileall app"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "docker build -f apps/audit_log/Dockerfile -t jccasav/sibu-audit_log:local ."
      }
    },
    "docker-push": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "bash tools/docker/push.sh audit_log"
      }
    }
  }
}
