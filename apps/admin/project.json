{
  "name": "admin",
  "projectType": "application",
  "sourceRoot": "apps/admin/app",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "python -m uvicorn apps.admin.app.main:app --host 0.0.0.0 --port 8008 --reload"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "npx cross-env PYTHONPATH=. python -m pytest -q --import-mode=importlib apps/admin/tests"

      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/admin",
        "command": "python -m compileall app"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "docker build -f apps/admin/Dockerfile -t jccasav/sibu-admin:local ."
      }
    },
    "docker-push": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "bash tools/docker/push.sh admin"
      }
    }
  }
}
