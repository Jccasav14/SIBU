{
  "name": "admin",
  "projectType": "application",
  "sourceRoot": "apps/admin/app",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": ".\\.venv\\Scripts\\python.exe -m uvicorn apps.admin.app.main:app --host 0.0.0.0 --port 8008 --reload"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/admin",
        "command": "pytest -q"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/admin",
        "command": "python -m compileall app"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "docker build -f apps/admin/Dockerfile -t sibu-admin:local ."
      }
    }
  }
}
