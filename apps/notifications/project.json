{
  "name": "notifications",
  "projectType": "application",
  "root": "apps/notifications",
  "sourceRoot": "apps/notifications/app",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python -m uvicorn apps.notifications.app.main:app --host 0.0.0.0 --port 8004 --reload",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pytest -q",
        "cwd": "apps/notifications"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python -m compileall app",
        "cwd": "apps/notifications"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -t sibu-notifications -f apps/notifications/Dockerfile .",
        "cwd": "."
      }
    }
  }
}
