{
  "name": "coverage",
  "projectType": "application",
  "sourceRoot": "apps/coverage/app",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": ".\\.venv\\Scripts\\python.exe -m uvicorn apps.coverage.app.main:app --host 0.0.0.0 --port 8010 --reload"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/coverage",
        "command": "pytest -q"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/coverage",
        "command": "python -m compileall app"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "docker build -f apps/coverage/Dockerfile -t sibu-coverage:latest ."
      }
    }
  }
}
