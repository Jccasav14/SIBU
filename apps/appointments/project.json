{
  "name": "appointments",
  "root": "apps/appointments",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python -m uvicorn apps.appointments.app.main:app --host 0.0.0.0 --port 8005 --reload",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pytest",
        "cwd": "apps/appointments"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python -m compileall app",
        "cwd": "apps/appointments"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -f apps/appointments/Dockerfile -t sibu-appointments .",
        "cwd": "."
      }
    }
  }
}