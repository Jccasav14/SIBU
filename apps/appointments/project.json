{
  "name": "appointments",
  "root": "apps/appointments",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "python -m uvicorn apps.appointments.app.main:app --host 0.0.0.0 --port 8005 --reload"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "npx cross-env PYTHONPATH=. python -m pytest -q --import-mode=importlib apps/appointments/tests"

      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/appointments",
        "command": "python -m compileall app"
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "docker build -f apps/appointments/Dockerfile -t jccasav/sibu-appointments:local ."
      }
    },
    "docker-push": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "bash tools/docker/push.sh appointments"
      }
    }
  }
}
