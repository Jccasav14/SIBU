{
  "name": "reports",
  "projectType": "application",
  "sourceRoot": "apps/reports/app",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "python -m uvicorn apps.reports.app.main:app --host 0.0.0.0 --port 8011 --reload"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "npx cross-env PYTHONPATH=. .\\.venv\\Scripts\\python.exe -m pytest -q --import-mode=importlib apps/reports/tests"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/reports",
        "command": "python -m compileall app"
      }
    }
  }
}
