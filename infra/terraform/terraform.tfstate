            ],
            "private_ip": "172.31.93.45",
            "public_dns": "ec2-13-222-243-177.compute-1.amazonaws.com",
            "public_ip": "13.222.243.177",
            "region": "us-east-1",
            "root_block_device": [
              {
                "delete_on_termination": true,
                "device_name": "/dev/xvda",
                "encrypted": false,
                "iops": 3000,
                "kms_key_id": "",
