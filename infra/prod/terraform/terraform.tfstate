            "tags": {
              "Name": "sibu-prod-admin-reports"
            },
            "tags_all": {
              "Name": "sibu-prod-admin-reports"
            },
            "tenancy": "default",
            "timeouts": null,
            "user_data": "#!/bin/bash\nset -euxo pipefail\n\ndnf update -y\ndnf install -y docker git nmap-ncat\n\n# -----------------------------\n# Swap (prevents OOM lockups)\n# -----------------------------\nif ! swapon --show | grep -q \"^/swapfile\"; then\n  (fallocate -l 1G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=1024) \u003e/dev/null 2\u003e\u00261 || true\n  chmod 600 /swapfile || true\n  mkswap /swapfile \u003e/dev/null 2\u003e\u00261 || true\n  swapon /swapfile || true\n  grep -q \"^/swapfile \" /etc/fstab 2\u003e/dev/null || echo \"/swapfile swap swap defaults 0 0\" \u003e\u003e /etc/fstab\nfi\n\n# -----------------------------\n# Docker\n# -----------------------------\ngroupadd -f docker || true\nsystemctl enable --now docker\nusermod -aG docker ec2-user || true\nchmod 666 /var/run/docker.sock || true\nsleep 5\n\ndocker network create sibu-net || true\n\n# =============================\n# Terraform vars -\u003e Bash vars\n# =============================\nDATA_IP=\"172.31.6.76\"\n\nADMIN_HOST_PORT=\"8006\"\nADMIN_CONTAINER_PORT=\"8008\"\n\nREPORTS_HOST_PORT=\"8005\"\nREPORTS_CONTAINER_PORT=\"8007\"\n\n# =============================\n# Wait for shared DATA services\n# =============================\necho \"Waiting for Postgres at $DATA_IP:5432 ...\"\nfor i in {1..90}; do\n  nc -z \"$DATA_IP\" 5432 \u0026\u0026 break\n  sleep 2\ndone\n\necho \"Waiting for Redis at $DATA_IP:6379 ...\"\nfor i in {1..90}; do\n  nc -z \"$DATA_IP\" 6379 \u0026\u0026 break\n  sleep 2\ndone\n\necho \"Waiting for Kafka at $DATA_IP:29092 ...\"\nfor i in {1..90}; do\n  nc -z \"$DATA_IP\" 29092 \u0026\u0026 break\n  sleep 2\ndone\n\necho \"Waiting for RabbitMQ at $DATA_IP:5672 ...\"\nfor i in {1..90}; do\n  nc -z \"$DATA_IP\" 5672 \u0026\u0026 break\n  sleep 2\ndone\n\nsleep 5\n\n# =============================\n# Admin env vars\n# =============================\nDATABASE_URL=\"postgresql+asyncpg://sibu:sibu@$DATA_IP:5432/sibu\"\nDB_HOST=\"$DATA_IP\"\nDB_PORT=\"5432\"\nDB_USER=\"sibu\"\nDB_PASSWORD=\"sibu\"\nDB_NAME=\"sibu\"\n\n# JWT (for QA)\nJWT_SECRET=\"SIBU_SUPER_SECRET_CAMBIAME\"\nJWT_ALGORITHM=\"HS256\"\n\n# =============================\n# Run Admin service\n# =============================\ndocker pull jccasav/sibu-admin:qa\ndocker rm -f sibu-admin || true\n\ndocker run -d \\\n  --name sibu-admin \\\n  --restart always \\\n  -p \"$ADMIN_HOST_PORT:$ADMIN_CONTAINER_PORT\" \\\n  --add-host \"postgres:$DATA_IP\" \\\n  --add-host \"redis:$DATA_IP\" \\\n  -e \"DATABASE_URL=$DATABASE_URL\" \\\n  -e \"DB_HOST=$DB_HOST\" \\\n  -e \"DB_PORT=$DB_PORT\" \\\n  -e \"DB_USER=$DB_USER\" \\\n  -e \"DB_PASSWORD=$DB_PASSWORD\" \\\n  -e \"DB_NAME=$DB_NAME\" \\\n  -e \"JWT_SECRET=$JWT_SECRET\" \\\n  -e \"JWT_ALGORITHM=$JWT_ALGORITHM\" \\\n  jccasav/sibu-admin:qa\n\n# =============================\n# Run Reports service\n# =============================\ndocker pull jccasav/sibu-reports:qa\ndocker rm -f sibu-reports || true\n\ndocker run -d \\\n  --name sibu-reports \\\n  --restart always \\\n  -p \"$REPORTS_HOST_PORT:$REPORTS_CONTAINER_PORT\" \\\n  --network sibu-net \\\n  --add-host reports_postgres:$DATA_IP \\\n  --add-host kafka:$DATA_IP \\\n  --add-host rabbitmq:$DATA_IP \\\n  jccasav/sibu-reports:qa\n\nsleep 3\ncurl -sS -i \"http://127.0.0.1:$ADMIN_HOST_PORT/health\" || true\ncurl -sS -i \"http://127.0.0.1:$REPORTS_HOST_PORT/health\" || true\n",
            "user_data_base64": null,
            "user_data_replace_on_change": false,
            "volume_tags": null,
            "vpc_security_group_ids": [
              "sg-0230ceddd7cfef637"
            ]
          },
