              "sibu-prod-sg1"
            ],
            "source_dest_check": true,
            "spot_instance_request_id": "",
            "subnet_id": "subnet-0c9b4af62d0fe6c35",
            "tags": {
              "Name": "sibu-prod-data"
            },
            "tags_all": {
              "Name": "sibu-prod-data"
            },
            "tenancy": "default",
            "timeouts": null,
            "user_data": "#!/bin/bash\nset -euxo pipefail\n\ndnf update -y\ndnf install -y docker git nmap-ncat\n\n# -----------------------------\n# Swap (prevents OOM lockups on small instances)\n# -----------------------------\nif ! swapon --show | grep -q \"^/swapfile\"; then\n  (fallocate -l 1G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=1024) \u003e/dev/null 2\u003e\u00261 || true\n  chmod 600 /swapfile || true\n  mkswap /swapfile \u003e/dev/null 2\u003e\u00261 || true\n  swapon /swapfile || true\n  grep -q \"^/swapfile \" /etc/fstab 2\u003e/dev/null || echo \"/swapfile swap swap defaults 0 0\" \u003e\u003e /etc/fstab\nfi\n\ngroupadd -f docker || true\nsystemctl enable --now docker\nusermod -aG docker ec2-user || true\nchmod 666 /var/run/docker.sock || true\n\nsleep 5\ndocker network create sibu-net || true\n\nDATA_IP=\"$(hostname -I | awk '{print $1}')\"\necho \"DATA_IP=$DATA_IP\"\n\n# -----------------------------\n# Postgres\n# -----------------------------\ndocker pull postgres:16\ndocker rm -f sibu-postgres || true\ndocker volume create pgdata || true\n\ndocker run -d --name sibu-postgres --restart always \\\n  --network sibu-net \\\n  -p 5432:5432 \\\n  -e POSTGRES_USER=sibu \\\n  -e POSTGRES_PASSWORD=sibu \\\n  -e POSTGRES_DB=sibu \\\n  -v pgdata:/var/lib/postgresql/data \\\n  postgres:16\n\n# Wait Postgres\nfor i in {1..90}; do\n  if docker exec sibu-postgres pg_isready -U sibu -d sibu \u003e/dev/null 2\u003e\u00261; then\n    echo \"Postgres ready\"\n    break\n  fi\n  echo \"Postgres not ready yet ($i)...\"\n  sleep 2\ndone\n\n# -----------------------------\n# DB provisioning (idempotent)\n# - reports role/db (ya lo tenías)\n# - postgres role (admin lo necesita)\n# - sibu_admin database (admin lo necesita)\n# -----------------------------\n\n# Ensure REPORTS role exists + password\ndocker exec sibu-postgres psql -U sibu -d postgres -v ON_ERROR_STOP=1 -c \\\n\"DO \\$\\$ BEGIN\n  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='reports') THEN\n    CREATE ROLE reports WITH LOGIN PASSWORD 'reports';\n  ELSE\n    ALTER ROLE reports WITH LOGIN PASSWORD 'reports';\n  END IF;\nEND \\$\\$;\"\n\n# Create reports database if missing (NO DO $$)\nif ! docker exec sibu-postgres psql -U sibu -d postgres -tAc \"SELECT 1 FROM pg_database WHERE datname='reports'\" | grep -q 1; then\n  docker exec sibu-postgres createdb -U sibu -O reports reports\nfi\n\n# Permissions for reports user\ndocker exec sibu-postgres psql -U sibu -d postgres -v ON_ERROR_STOP=1 -c \"GRANT CONNECT ON DATABASE reports TO reports;\" || true\ndocker exec sibu-postgres psql -U sibu -d reports  -v ON_ERROR_STOP=1 -c \"GRANT USAGE ON SCHEMA public TO reports;\" || true\ndocker exec sibu-postgres psql -U sibu -d reports  -v ON_ERROR_STOP=1 -c \"GRANT SELECT,INSERT,UPDATE,DELETE ON ALL TABLES IN SCHEMA public TO reports;\" || true\ndocker exec sibu-postgres psql -U sibu -d reports  -v ON_ERROR_STOP=1 -c \"GRANT USAGE,SELECT,UPDATE ON ALL SEQUENCES IN SCHEMA public TO reports;\" || true\ndocker exec sibu-postgres psql -U sibu -d reports  -v ON_ERROR_STOP=1 -c \"ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT,INSERT,UPDATE,DELETE ON TABLES TO reports;\" || true\ndocker exec sibu-postgres psql -U sibu -d reports  -v ON_ERROR_STOP=1 -c \"ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT USAGE,SELECT,UPDATE ON SEQUENCES TO reports;\" || true\n\n# Ensure role 'postgres' exists (admin intenta user=postgres)\ndocker exec sibu-postgres psql -U sibu -d postgres -v ON_ERROR_STOP=1 -c \\\n\"DO \\$\\$ BEGIN\n  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='postgres') THEN\n    CREATE ROLE postgres WITH LOGIN SUPERUSER PASSWORD 'postgres';\n  ELSE\n    ALTER ROLE postgres WITH LOGIN SUPERUSER PASSWORD 'postgres';\n  END IF;\nEND \\$\\$;\"\n\n# Ensure database 'sibu_admin' exists (admin intenta DB=sibu_admin) - NO DO $$\nif ! docker exec sibu-postgres psql -U sibu -d postgres -tAc \"SELECT 1 FROM pg_database WHERE datname='sibu_admin'\" | grep -q 1; then\n  docker exec sibu-postgres createdb -U sibu -O sibu sibu_admin\nfi\n\n# -----------------------------\n# Redis (admin lo necesita como host \"redis:6379\")\n# -----------------------------\ndocker pull redis:7-alpine\ndocker rm -f redis || true\ndocker run -d --name redis --restart always \\\n  --network sibu-net \\\n  -p 6379:6379 \\\n  redis:7-alpine\n\n# Wait Redis\nfor i in {1..60}; do\n  if nc -z 127.0.0.1 6379 \u003e/dev/null 2\u003e\u00261; then\n    echo \"Redis ready\"\n    break\n  fi\n  echo \"Redis not ready yet ($i)...\"\n  sleep 2\ndone\n\n# -----------------------------\n# RabbitMQ (management)\n# -----------------------------\ndocker pull rabbitmq:3.13-management\ndocker rm -f rabbitmq || true\ndocker volume create rabbitmq_data || true\n\ndocker run -d --name rabbitmq --restart always \\\n  --network sibu-net \\\n  -p 5672:5672 \\\n  -p 15672:15672 \\\n  -v rabbitmq_data:/var/lib/rabbitmq \\\n  rabbitmq:3.13-management\n\nfor i in {1..90}; do\n  if nc -z 127.0.0.1 5672 \u003e/dev/null 2\u003e\u00261 \u0026\u0026 nc -z 127.0.0.1 15672 \u003e/dev/null 2\u003e\u00261; then\n    echo \"RabbitMQ ready\"\n    break\n  fi\n  echo \"RabbitMQ not ready yet ($i)...\"\n  sleep 2\ndone\n\n# -----------------------------\n# Zookeeper\n# -----------------------------\ndocker pull confluentinc/cp-zookeeper:7.6.1\ndocker rm -f sibu-zookeeper || true\n\ndocker run -d --name sibu-zookeeper --restart always \\\n  --network sibu-net \\\n  -p 2181:2181 \\\n  -e ZOOKEEPER_CLIENT_PORT=2181 \\\n  -e ZOOKEEPER_TICK_TIME=2000 \\\n  confluentinc/cp-zookeeper:7.6.1\n\nfor i in {1..60}; do\n  if nc -z 127.0.0.1 2181 \u003e/dev/null 2\u003e\u00261; then\n    echo \"Zookeeper ready\"\n    break\n  fi\n  echo \"Zookeeper not ready yet ($i)...\"\n  sleep 2\ndone\n\n# -----------------------------\n# Kafka\n# -----------------------------\ndocker pull confluentinc/cp-kafka:7.6.1\ndocker rm -f kafka || true\n\ndocker run -d --name kafka --restart always \\\n  --network sibu-net \\\n  -p 29092:29092 \\\n  -e KAFKA_BROKER_ID=1 \\\n  -e KAFKA_ZOOKEEPER_CONNECT=\"sibu-zookeeper:2181\" \\\n  -e KAFKA_LISTENERS=\"PLAINTEXT://0.0.0.0:29092\" \\\n  -e KAFKA_ADVERTISED_LISTENERS=\"PLAINTEXT://$DATA_IP:29092\" \\\n  -e KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=\"PLAINTEXT:PLAINTEXT\" \\\n  -e KAFKA_INTER_BROKER_LISTENER_NAME=\"PLAINTEXT\" \\\n  -e KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1 \\\n  -e KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1 \\\n  -e KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1 \\\n  -e KAFKA_AUTO_CREATE_TOPICS_ENABLE=false \\\n  -e KAFKA_LOG_CLEANER_ENABLE=false \\\n  -e KAFKA_HEAP_OPTS=\"-Xms384m -Xmx384m\" \\\n  --memory=\"900m\" --memory-swap=\"1400m\" \\\n  confluentinc/cp-kafka:7.6.1\n\nfor i in {1..90}; do\n  if nc -z 127.0.0.1 29092 \u003e/dev/null 2\u003e\u00261; then\n    echo \"Kafka port open\"\n    break\n  fi\n  echo \"Kafka not ready yet ($i)...\"\n  sleep 2\ndone\n\nfor i in {1..120}; do\n  if docker exec kafka kafka-topics --bootstrap-server 127.0.0.1:29092 --list \u003e/dev/null 2\u003e\u00261; then\n    echo \"Kafka metadata ready\"\n    break\n  fi\n  echo \"Kafka metadata not ready yet ($i)...\"\n  sleep 2\ndone\n\n# -----------------------------\n# Topics (idempotent)\n# -----------------------------\ndocker exec kafka kafka-topics --bootstrap-server 127.0.0.1:29092 \\\n  --create --if-not-exists --topic sibu.user.events --partitions 1 --replication-factor 1 || true\n\ndocker exec kafka kafka-topics --bootstrap-server 127.0.0.1:29092 \\\n  --create --if-not-exists --topic sibu.events --partitions 1 --replication-factor 1 || true\n\ndocker exec kafka kafka-topics --bootstrap-server 127.0.0.1:29092 \\\n  --create --if-not-exists --topic sibu.cases.events --partitions 1 --replication-factor 1 || true\n\ndocker exec kafka kafka-topics --bootstrap-server 127.0.0.1:29092 \\\n  --create --if-not-exists --topic sibu.appointments.events --partitions 1 --replication-factor 1 || true\n\ndocker exec kafka kafka-topics --bootstrap-server 127.0.0.1:29092 --list || true\n",
            "user_data_base64": null,
            "user_data_replace_on_change": false,
