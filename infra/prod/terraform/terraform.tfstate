            "tenancy": "default",
            "timeouts": null,
            "user_data": "#!/bin/bash\nset -eux\n\ndnf update -y\ndnf install -y docker nmap-ncat\n\n# -----------------------------\n# Swap (prevents OOM lockups on small instances)\n# -----------------------------\nif ! swapon --show | grep -q \"^/swapfile\"; then\n  (fallocate -l 1G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=1024) \u003e/dev/null 2\u003e\u00261 || true\n  chmod 600 /swapfile || true\n  mkswap /swapfile \u003e/dev/null 2\u003e\u00261 || true\n  swapon /swapfile || true\n  grep -q \"^/swapfile \" /etc/fstab 2\u003e/dev/null || echo \"/swapfile swap swap defaults 0 0\" \u003e\u003e /etc/fstab\nfi\n\ngroupadd -f docker || true\nsystemctl enable docker\nsystemctl start docker\nusermod -aG docker ec2-user || true\nchmod 666 /var/run/docker.sock || true\nsleep 5\n\ndocker network create sibu-net || true\n\n# --- DATA endpoints (DATA instance private IP) ---\nDATA_IP=\"172.31.6.76\"\n\n# --- Wait for DATA ports (Postgres/Kafka/Rabbit/Redis) ---\nfor port in 5432 29092 5672 6379; do\n  echo \"Waiting for DATA ${DATA_IP}:${port} ...\"\n  for i in {1..90}; do\n    if nc -z \"${DATA_IP}\" \"${port}\" \u003e/dev/null 2\u003e\u00261; then\n      echo \"DATA ${DATA_IP}:${port} reachable\"\n      break\n    fi\n    echo \"Not ready yet (${i})...\"\n    sleep 2\n  done\ndone\n\n# --- Common env (BASH vars) ---\nCOMMON_DSN=\"postgresql+asyncpg://sibu:sibu@${DATA_IP}:5432/sibu\"\nREDIS_URL=\"redis://${DATA_IP}:6379/0\"\nRABBIT_URL=\"amqp://guest:guest@${DATA_IP}:5672/\"\nKAFKA_BOOTSTRAP=\"${DATA_IP}:29092\"\n\nJWT_SECRET=\"SIBU_SUPER_SECRET_CAMBIAME\"\nJWT_ALGORITHM=\"HS256\"\n\n# =========================================================\n# NOTIFICATIONS (container listens 8004, expose ONLY 8007)\n# =========================================================\ndocker pull jccasav/sibu-notifications:qa\ndocker rm -f sibu-notifications || true\ndocker run -d --name sibu-notifications --restart always \\\n  --network sibu-net \\\n  -p 8007:8004 \\\n  --add-host postgres:${DATA_IP} \\\n  --add-host db:${DATA_IP} \\\n  --add-host redis:${DATA_IP} \\\n  --add-host rabbitmq:${DATA_IP} \\\n  --add-host kafka:${DATA_IP} \\\n  -e DATABASE_URL=\"${COMMON_DSN}\" \\\n  -e POSTGRES_DSN=\"${COMMON_DSN}\" \\\n  -e DB_HOST=\"${DATA_IP}\" -e DB_PORT=\"5432\" \\\n  -e PGHOST=\"${DATA_IP}\" -e PGPORT=\"5432\" \\\n  -e REDIS_URL=\"${REDIS_URL}\" \\\n  -e RABBITMQ_URL=\"${RABBIT_URL}\" \\\n  -e KAFKA_BOOTSTRAP_SERVERS=\"${KAFKA_BOOTSTRAP}\" \\\n  -e JWT_SECRET=\"${JWT_SECRET}\" -e JWT_ALGORITHM=\"${JWT_ALGORITHM}\" \\\n  jccasav/sibu-notifications:qa\n\n# =========================================================\n# CLAIMS (listens 8009, MUST set CLAIMS_POSTGRES_DSN)\n# =========================================================\ndocker pull jccasav/sibu-claims:qa\ndocker rm -f sibu-claims || true\ndocker run -d --name sibu-claims --restart always \\\n  --network sibu-net \\\n  -p 8009:8009 \\\n  --add-host postgres:${DATA_IP} \\\n  --add-host db:${DATA_IP} \\\n  --add-host redis:${DATA_IP} \\\n  --add-host rabbitmq:${DATA_IP} \\\n  --add-host kafka:${DATA_IP} \\\n  --add-host claims-postgres:${DATA_IP} \\\n  -e CLAIMS_POSTGRES_DSN=\"${COMMON_DSN}\" \\\n  -e DATABASE_URL=\"${COMMON_DSN}\" \\\n  -e POSTGRES_DSN=\"${COMMON_DSN}\" \\\n  -e DB_HOST=\"${DATA_IP}\" -e DB_PORT=\"5432\" \\\n  -e PGHOST=\"${DATA_IP}\" -e PGPORT=\"5432\" \\\n  -e REDIS_URL=\"${REDIS_URL}\" \\\n  -e RABBITMQ_URL=\"${RABBIT_URL}\" \\\n  -e KAFKA_BOOTSTRAP_SERVERS=\"${KAFKA_BOOTSTRAP}\" \\\n  -e JWT_SECRET=\"${JWT_SECRET}\" -e JWT_ALGORITHM=\"${JWT_ALGORITHM}\" \\\n  jccasav/sibu-claims:qa\n\n# =========================================================\n# COVERAGE (uvicorn runs 8010, MUST set COVERAGE_POSTGRES_DSN)\n# =========================================================\ndocker pull jccasav/sibu-coverage:qa\ndocker rm -f sibu-coverage || true\ndocker run -d --name sibu-coverage --restart always \\\n  --network sibu-net \\\n  -p 8010:8010 \\\n  --add-host postgres:${DATA_IP} \\\n  --add-host db:${DATA_IP} \\\n  --add-host redis:${DATA_IP} \\\n  --add-host rabbitmq:${DATA_IP} \\\n  --add-host kafka:${DATA_IP} \\\n  -e COVERAGE_POSTGRES_DSN=\"${COMMON_DSN}\" \\\n  -e DATABASE_URL=\"${COMMON_DSN}\" \\\n  -e POSTGRES_DSN=\"${COMMON_DSN}\" \\\n  -e DB_HOST=\"${DATA_IP}\" -e DB_PORT=\"5432\" \\\n  -e PGHOST=\"${DATA_IP}\" -e PGPORT=\"5432\" \\\n  -e REDIS_URL=\"${REDIS_URL}\" \\\n  -e RABBITMQ_URL=\"${RABBIT_URL}\" \\\n  -e KAFKA_BOOTSTRAP_SERVERS=\"${KAFKA_BOOTSTRAP}\" \\\n  -e JWT_SECRET=\"${JWT_SECRET}\" -e JWT_ALGORITHM=\"${JWT_ALGORITHM}\" \\\n  jccasav/sibu-coverage:qa\n\n# ---------------------------------------------------------\n# Quick local checks (non-failing)\n# ---------------------------------------------------------\nsleep 3\ncurl -sS http://127.0.0.1:8007/health || true\ncurl -sS http://127.0.0.1:8009/health || true\ncurl -sS http://127.0.0.1:8010/health || true\ncurl -sS http://127.0.0.1:8010/docs || true\n\ndocker rm -f claims-debug || true\n",
