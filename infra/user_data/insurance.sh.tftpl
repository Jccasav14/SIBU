#!/bin/bash
set -euxo pipefail

dnf update -y
dnf install -y docker git nmap-ncat

# Swap (prevents OOM lockups on small instances)
if ! swapon --show | grep -q "^/swapfile"; then
  (fallocate -l 1G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=1024) >/dev/null 2>&1 || true
  chmod 600 /swapfile || true
  mkswap /swapfile >/dev/null 2>&1 || true
  swapon /swapfile || true
  grep -q "^/swapfile " /etc/fstab 2>/dev/null || echo "/swapfile swap swap defaults 0 0" >> /etc/fstab
fi

groupadd -f docker || true
systemctl enable --now docker
usermod -aG docker ec2-user || true
chmod 666 /var/run/docker.sock || true
sleep 5

docker network create sibu-net || true

DATA_IP="${data_ip}"

echo "Waiting for Postgres at ${DATA_IP}:5432 ..."
for i in {1..120}; do
  nc -z "${DATA_IP}" 5432 >/dev/null 2>&1 && break || true
  sleep 2
done

echo "Waiting for Redis at ${DATA_IP}:6379 ..."
for i in {1..120}; do
  nc -z "${DATA_IP}" 6379 >/dev/null 2>&1 && break || true
  sleep 2
done

echo "Waiting for RabbitMQ at ${DATA_IP}:5672 ..."
for i in {1..120}; do
  nc -z "${DATA_IP}" 5672 >/dev/null 2>&1 && break || true
  sleep 2
done

echo "Waiting for Kafka at ${DATA_IP}:29092 ..."
for i in {1..120}; do
  nc -z "${DATA_IP}" 29092 >/dev/null 2>&1 && break || true
  sleep 2
done

# Common env (best-effort)
JWT_SECRET="SIBU_SUPER_SECRET_CAMBIAME"
JWT_ALGORITHM="HS256"

POSTGRES_DSN="postgresql+asyncpg://sibu:sibu@postgres:5432/sibu"
DATABASE_URL="postgresql+asyncpg://sibu:sibu@postgres:5432/sibu"
REDIS_URL="redis://redis:6379/0"
RABBITMQ_URL="amqp://guest:guest@rabbitmq:5672/"
KAFKA_BOOTSTRAP_SERVERS="kafka:29092"

# Map service hostnames to DATA private IP
ADD_HOSTS=(--add-host "postgres:${DATA_IP}" --add-host "redis:${DATA_IP}" --add-host "rabbitmq:${DATA_IP}" --add-host "kafka:${DATA_IP}")

# Pull images
docker pull jccasav/sibu-notifications:qa
docker pull jccasav/sibu-claims:qa
docker pull jccasav/sibu-coverage:qa

# Stop old containers (idempotent)
docker rm -f sibu-notifications 2>/dev/null || true
docker rm -f sibu-claims 2>/dev/null || true
docker rm -f sibu-coverage 2>/dev/null || true

# Notifications (8004)
docker run -d --name sibu-notifications --restart unless-stopped \
  -p 8004:8004 \
  "${ADD_HOSTS[@]}" \
  -e "JWT_SECRET=${JWT_SECRET}" -e "JWT_ALGORITHM=${JWT_ALGORITHM}" \
  -e "POSTGRES_DSN=${POSTGRES_DSN}" -e "DATABASE_URL=${DATABASE_URL}" \
  -e "REDIS_URL=${REDIS_URL}" -e "RABBITMQ_URL=${RABBITMQ_URL}" -e "KAFKA_BOOTSTRAP_SERVERS=${KAFKA_BOOTSTRAP_SERVERS}" \
  jccasav/sibu-notifications:qa

# Claims (8009)
docker run -d --name sibu-claims --restart unless-stopped \
  -p 8009:8009 \
  "${ADD_HOSTS[@]}" \
  -e "JWT_SECRET=${JWT_SECRET}" -e "JWT_ALGORITHM=${JWT_ALGORITHM}" \
  -e "POSTGRES_DSN=${POSTGRES_DSN}" -e "DATABASE_URL=${DATABASE_URL}" \
  -e "REDIS_URL=${REDIS_URL}" -e "RABBITMQ_URL=${RABBITMQ_URL}" -e "KAFKA_BOOTSTRAP_SERVERS=${KAFKA_BOOTSTRAP_SERVERS}" \
  jccasav/sibu-claims:qa

# Coverage (8010)
docker run -d --name sibu-coverage --restart unless-stopped \
  -p 8010:8010 \
  "${ADD_HOSTS[@]}" \
  -e "JWT_SECRET=${JWT_SECRET}" -e "JWT_ALGORITHM=${JWT_ALGORITHM}" \
  -e "POSTGRES_DSN=${POSTGRES_DSN}" -e "DATABASE_URL=${DATABASE_URL}" \
  -e "REDIS_URL=${REDIS_URL}" -e "RABBITMQ_URL=${RABBITMQ_URL}" -e "KAFKA_BOOTSTRAP_SERVERS=${KAFKA_BOOTSTRAP_SERVERS}" \
  jccasav/sibu-coverage:qa

sleep 3
curl -sS -i http://127.0.0.1:8004/health || true
curl -sS -i http://127.0.0.1:8009/health || true
curl -sS -i http://127.0.0.1:8010/health || true
