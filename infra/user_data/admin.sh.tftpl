#!/bin/bash
set -euxo pipefail

dnf update -y
dnf install -y docker git nmap-ncat

# -----------------------------
# Swap (prevents OOM lockups on small instances)
# -----------------------------
if ! swapon --show | grep -q "^/swapfile"; then
  (fallocate -l 1G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=1024) >/dev/null 2>&1 || true
  chmod 600 /swapfile || true
  mkswap /swapfile >/dev/null 2>&1 || true
  swapon /swapfile || true
  grep -q "^/swapfile " /etc/fstab 2>/dev/null || echo "/swapfile swap swap defaults 0 0" >> /etc/fstab
fi

groupadd -f docker || true
systemctl enable --now docker
usermod -aG docker ec2-user || true
chmod 666 /var/run/docker.sock || true
sleep 5

docker network create sibu-net || true

# --- DATA endpoints (DATA instance private IP) ---
DATA_IP="${data_ip}"

# Service ports (observado por docker inspect)
HOST_PORT="8006"
CONTAINER_PORT="8008"

# --- Wait for Postgres / Kafka / Redis ---
echo "Waiting for Postgres at $DATA_IP:5432 ..."
for i in {1..90}; do
  if nc -z "$DATA_IP" 5432 >/dev/null 2>&1; then
    echo "Postgres reachable"
    break
  fi
  echo "Postgres not ready yet ($i)..."
  sleep 2
done

echo "Waiting for Redis at $DATA_IP:6379 ..."
for i in {1..90}; do
  if nc -z "$DATA_IP" 6379 >/dev/null 2>&1; then
    echo "Redis reachable"
    break
  fi
  echo "Redis not ready yet ($i)..."
  sleep 2
done

echo "Waiting for Kafka at $DATA_IP:29092 ..."
for i in {1..90}; do
  if nc -z "$DATA_IP" 29092 >/dev/null 2>&1; then
    echo "Kafka port reachable"
    break
  fi
  echo "Kafka not ready yet ($i)..."
  sleep 2
done
sleep 5

# envs (aunque admin parece usar defaults internos, las dejamos)
DATABASE_URL="postgresql+asyncpg://sibu:sibu@$DATA_IP:5432/sibu"
DB_HOST="$DATA_IP"
DB_PORT="5432"
DB_USER="sibu"
DB_PASSWORD="sibu"
DB_NAME="sibu"

docker pull jccasav/sibu-admin:qa
docker rm -f sibu-admin || true

docker run -d --name sibu-admin --restart always \
  -p ${HOST_PORT}:${CONTAINER_PORT} \
  --add-host postgres:${DATA_IP} \
  --add-host redis:${DATA_IP} \
  -e DATABASE_URL="$DATABASE_URL" \
  -e DB_HOST="$DB_HOST" \
  -e DB_PORT="$DB_PORT" \
  -e DB_USER="$DB_USER" \
  -e DB_PASSWORD="$DB_PASSWORD" \
  -e DB_NAME="$DB_NAME" \
  jccasav/sibu-admin:qa

# Quick local check
sleep 3
curl -sS -i "http://127.0.0.1:${HOST_PORT}/health" || true
curl -sS -i "http://127.0.0.1:${HOST_PORT}/docs" || true
