#!/bin/bash
set -eux

dnf update -y
dnf install -y nginx

cat > /etc/nginx/conf.d/sibu-gateway.conf <<'NGINX'
server {
  listen 80;
  server_name _;
  location = /health { add_header Content-Type text/plain; return 200 "ok"; }

  location /auth/ { proxy_pass http://__AUTHUSERS_IP__:8000/; }
  location = /auth { proxy_pass http://__AUTHUSERS_IP__:8000/; }
  location /users/ { proxy_pass http://__AUTHUSERS_IP__:8001/; }
  location = /users { proxy_pass http://__AUTHUSERS_IP__:8001/; }

  location /cases/ { proxy_pass http://__APPTCASES_IP__:8002/; }
  location = /cases { proxy_pass http://__APPTCASES_IP__:8002/; }
  location /appointments/ { proxy_pass http://__APPTCASES_IP__:8003/; }
  location = /appointments { proxy_pass http://__APPTCASES_IP__:8003/; }

  location /audit/ { proxy_pass http://__AUDIT_IP__:8004/; }
  location = /audit { proxy_pass http://__AUDIT_IP__:8004/; }
  location /reports/ { proxy_pass http://__REPORTS_IP__:8005/; }
  location = /reports { proxy_pass http://__REPORTS_IP__:8005/; }
  location /admin/ { proxy_pass http://__ADMIN_IP__:8006/; }
  location = /admin { proxy_pass http://__ADMIN_IP__:8006/; }

  location /notifications/ { proxy_pass http://__INSURANCE_IP__:8007/; }
  location = /notifications { proxy_pass http://__INSURANCE_IP__:8007/; }
  location /claims/ { proxy_pass http://__INSURANCE_IP__:8009/; }
  location = /claims { proxy_pass http://__INSURANCE_IP__:8009/; }
  location /coverage/ { proxy_pass http://__INSURANCE_IP__:8010/; }
  location = /coverage { proxy_pass http://__INSURANCE_IP__:8010/; }
}
NGINX

# Replace placeholders with real private IPs (Terraform templates)
sed -i "s/__AUTHUSERS_IP__/${authusers_ip}/g" /etc/nginx/conf.d/sibu-gateway.conf
sed -i "s/__APPTCASES_IP__/${appointments_cases_ip}/g" /etc/nginx/conf.d/sibu-gateway.conf
sed -i "s/__AUDIT_IP__/${audit_ip}/g" /etc/nginx/conf.d/sibu-gateway.conf
sed -i "s/__REPORTS_IP__/${reports_ip}/g" /etc/nginx/conf.d/sibu-gateway.conf
sed -i "s/__INSURANCE_IP__/${insurance_ip}/g" /etc/nginx/conf.d/sibu-gateway.conf
sed -i "s/__ADMIN_IP__/${admin_ip}/g" /etc/nginx/conf.d/sibu-gateway.conf

systemctl enable nginx
systemctl restart nginx

# Quick local check
curl -sS http://127.0.0.1/health || true
