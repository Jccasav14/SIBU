#!/bin/bash
set -euxo pipefail

dnf update -y
dnf install -y docker git nmap-ncat

# -----------------------------
# Swap (prevents OOM lockups on small instances)
# -----------------------------
if ! swapon --show | grep -q "^/swapfile"; then
  (fallocate -l 1G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=1024) >/dev/null 2>&1 || true
  chmod 600 /swapfile || true
  mkswap /swapfile >/dev/null 2>&1 || true
  swapon /swapfile || true
  grep -q "^/swapfile " /etc/fstab 2>/dev/null || echo "/swapfile swap swap defaults 0 0" >> /etc/fstab
fi

groupadd -f docker || true
systemctl enable --now docker
usermod -aG docker ec2-user || true
chmod 666 /var/run/docker.sock || true

sleep 5
docker network create sibu-net || true

DATA_IP="$(hostname -I | awk '{print $1}')"
echo "DATA_IP=$DATA_IP"

# -----------------------------
# Postgres
# -----------------------------
docker pull postgres:16
docker rm -f sibu-postgres || true
docker volume create pgdata || true

docker run -d --name sibu-postgres --restart always \
  --network sibu-net \
  -p 5432:5432 \
  -e POSTGRES_USER=sibu \
  -e POSTGRES_PASSWORD=sibu \
  -e POSTGRES_DB=sibu \
  -v pgdata:/var/lib/postgresql/data \
  postgres:16

# Wait Postgres
for i in {1..90}; do
  if docker exec sibu-postgres pg_isready -U sibu -d sibu >/dev/null 2>&1; then
    echo "Postgres ready"
    break
  fi
  echo "Postgres not ready yet ($i)..."
  sleep 2
done

# -----------------------------
# DB provisioning (idempotent)
# - reports role/db (ya lo tenías)
# - postgres role (admin lo necesita)
# - sibu_admin database (admin lo necesita)
# -----------------------------

# Ensure REPORTS role exists + password
docker exec sibu-postgres psql -U sibu -d postgres -v ON_ERROR_STOP=1 -c \
"DO \$\$ BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='reports') THEN
    CREATE ROLE reports WITH LOGIN PASSWORD 'reports';
  ELSE
    ALTER ROLE reports WITH LOGIN PASSWORD 'reports';
  END IF;
END \$\$;"

# Create reports database if missing (NO DO $$)
if ! docker exec sibu-postgres psql -U sibu -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname='reports'" | grep -q 1; then
  docker exec sibu-postgres createdb -U sibu -O reports reports
fi

# Permissions for reports user
docker exec sibu-postgres psql -U sibu -d postgres -v ON_ERROR_STOP=1 -c "GRANT CONNECT ON DATABASE reports TO reports;" || true
docker exec sibu-postgres psql -U sibu -d reports  -v ON_ERROR_STOP=1 -c "GRANT USAGE ON SCHEMA public TO reports;" || true
docker exec sibu-postgres psql -U sibu -d reports  -v ON_ERROR_STOP=1 -c "GRANT SELECT,INSERT,UPDATE,DELETE ON ALL TABLES IN SCHEMA public TO reports;" || true
docker exec sibu-postgres psql -U sibu -d reports  -v ON_ERROR_STOP=1 -c "GRANT USAGE,SELECT,UPDATE ON ALL SEQUENCES IN SCHEMA public TO reports;" || true
docker exec sibu-postgres psql -U sibu -d reports  -v ON_ERROR_STOP=1 -c "ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT,INSERT,UPDATE,DELETE ON TABLES TO reports;" || true
docker exec sibu-postgres psql -U sibu -d reports  -v ON_ERROR_STOP=1 -c "ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT USAGE,SELECT,UPDATE ON SEQUENCES TO reports;" || true

# Ensure role 'postgres' exists (admin intenta user=postgres)
docker exec sibu-postgres psql -U sibu -d postgres -v ON_ERROR_STOP=1 -c \
"DO \$\$ BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname='postgres') THEN
    CREATE ROLE postgres WITH LOGIN SUPERUSER PASSWORD 'postgres';
  ELSE
    ALTER ROLE postgres WITH LOGIN SUPERUSER PASSWORD 'postgres';
  END IF;
END \$\$;"

# Ensure database 'sibu_admin' exists (admin intenta DB=sibu_admin) - NO DO $$
if ! docker exec sibu-postgres psql -U sibu -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname='sibu_admin'" | grep -q 1; then
  docker exec sibu-postgres createdb -U sibu -O sibu sibu_admin
fi

# -----------------------------
# Redis (admin lo necesita como host "redis:6379")
# -----------------------------
docker pull redis:7-alpine
docker rm -f redis || true
docker run -d --name redis --restart always \
  --network sibu-net \
  -p 6379:6379 \
  redis:7-alpine

# Wait Redis
for i in {1..60}; do
  if nc -z 127.0.0.1 6379 >/dev/null 2>&1; then
    echo "Redis ready"
    break
  fi
  echo "Redis not ready yet ($i)..."
  sleep 2
done

# -----------------------------
# RabbitMQ (management)
# -----------------------------
docker pull rabbitmq:3.13-management
docker rm -f rabbitmq || true
docker volume create rabbitmq_data || true

docker run -d --name rabbitmq --restart always \
  --network sibu-net \
  -p 5672:5672 \
  -p 15672:15672 \
  -v rabbitmq_data:/var/lib/rabbitmq \
  rabbitmq:3.13-management

for i in {1..90}; do
  if nc -z 127.0.0.1 5672 >/dev/null 2>&1 && nc -z 127.0.0.1 15672 >/dev/null 2>&1; then
    echo "RabbitMQ ready"
    break
  fi
  echo "RabbitMQ not ready yet ($i)..."
  sleep 2
done

# -----------------------------
# Zookeeper
# -----------------------------
docker pull confluentinc/cp-zookeeper:7.6.1
docker rm -f sibu-zookeeper || true

docker run -d --name sibu-zookeeper --restart always \
  --network sibu-net \
  -p 2181:2181 \
  -e ZOOKEEPER_CLIENT_PORT=2181 \
  -e ZOOKEEPER_TICK_TIME=2000 \
  confluentinc/cp-zookeeper:7.6.1

for i in {1..60}; do
  if nc -z 127.0.0.1 2181 >/dev/null 2>&1; then
    echo "Zookeeper ready"
    break
  fi
  echo "Zookeeper not ready yet ($i)..."
  sleep 2
done

# -----------------------------
# Kafka
# -----------------------------
docker pull confluentinc/cp-kafka:7.6.1
docker rm -f kafka || true

docker run -d --name kafka --restart always \
  --network sibu-net \
  -p 29092:29092 \
  -e KAFKA_BROKER_ID=1 \
  -e KAFKA_ZOOKEEPER_CONNECT="sibu-zookeeper:2181" \
  -e KAFKA_LISTENERS="PLAINTEXT://0.0.0.0:29092" \
  -e KAFKA_ADVERTISED_LISTENERS="PLAINTEXT://$DATA_IP:29092" \
  -e KAFKA_LISTENER_SECURITY_PROTOCOL_MAP="PLAINTEXT:PLAINTEXT" \
  -e KAFKA_INTER_BROKER_LISTENER_NAME="PLAINTEXT" \
  -e KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1 \
  -e KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1 \
  -e KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1 \
  -e KAFKA_AUTO_CREATE_TOPICS_ENABLE=false \
  -e KAFKA_LOG_CLEANER_ENABLE=false \
  -e KAFKA_HEAP_OPTS="-Xms384m -Xmx384m" \
  --memory="900m" --memory-swap="1400m" \
  confluentinc/cp-kafka:7.6.1

for i in {1..90}; do
  if nc -z 127.0.0.1 29092 >/dev/null 2>&1; then
    echo "Kafka port open"
    break
  fi
  echo "Kafka not ready yet ($i)..."
  sleep 2
done

for i in {1..120}; do
  if docker exec kafka kafka-topics --bootstrap-server 127.0.0.1:29092 --list >/dev/null 2>&1; then
    echo "Kafka metadata ready"
    break
  fi
  echo "Kafka metadata not ready yet ($i)..."
  sleep 2
done

# -----------------------------
# Topics (idempotent)
# -----------------------------
docker exec kafka kafka-topics --bootstrap-server 127.0.0.1:29092 \
  --create --if-not-exists --topic sibu.user.events --partitions 1 --replication-factor 1 || true

docker exec kafka kafka-topics --bootstrap-server 127.0.0.1:29092 \
  --create --if-not-exists --topic sibu.events --partitions 1 --replication-factor 1 || true

docker exec kafka kafka-topics --bootstrap-server 127.0.0.1:29092 \
  --create --if-not-exists --topic sibu.cases.events --partitions 1 --replication-factor 1 || true

docker exec kafka kafka-topics --bootstrap-server 127.0.0.1:29092 \
  --create --if-not-exists --topic sibu.appointments.events --partitions 1 --replication-factor 1 || true

docker exec kafka kafka-topics --bootstrap-server 127.0.0.1:29092 --list || true
