            "public_dns": "ec2-44-210-140-116.compute-1.amazonaws.com",
            "public_ip": "44.210.140.116",
            "region": "us-east-1",
            "root_block_device": [
              {
                "delete_on_termination": true,
                "device_name": "/dev/xvda",
